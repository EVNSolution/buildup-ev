{
  "schema_version": 1,
  "contract_id": "warp-buildup-direct-api",
  "status": "compatibility-frozen",
  "owner": "OziinG",
  "issues": {
    "EVN-WARP": "https://github.com/EVNSolution/EVN-WARP/issues/38",
    "buildup-ev": "https://github.com/EVNSolution/buildup-ev/issues/241"
  },
  "authentication": {
    "current": "shared-api-key",
    "target": "directional-machine-client-with-capability"
  },
  "repositories": {
    "EVN-WARP": {
      "route_style": "next",
      "route_root": "app/api/external",
      "source_roots": [
        "app",
        "lib"
      ]
    },
    "buildup-ev": {
      "route_style": "express",
      "route_file": "backend/src/routes/external.ts",
      "route_prefix": "/api/external",
      "source_roots": [
        "backend/src"
      ]
    }
  },
  "endpoints": [
    {
      "id": "warp.customer.lookup",
      "method": "GET",
      "path": "/api/external/customer-lookup",
      "provider": "EVN-WARP",
      "caller": "buildup-ev",
      "capability": "customer.lookup.exact",
      "sources": {
        "EVN-WARP": {
          "file": "app/api/external/customer-lookup/route.ts",
          "token": "export async function GET"
        },
        "buildup-ev": {
          "file": "backend/src/services/warp-crm.ts",
          "token": "/api/external/customer-lookup?${q}"
        }
      }
    },
    {
      "id": "warp.deal-event.append",
      "method": "POST",
      "path": "/api/external/deal-events",
      "provider": "EVN-WARP",
      "caller": "buildup-ev",
      "capability": "deal-event.append",
      "sources": {
        "EVN-WARP": {
          "file": "app/api/external/deal-events/route.ts",
          "token": "export async function POST"
        },
        "buildup-ev": {
          "file": "backend/src/services/warp-crm.ts",
          "token": "/api/external/deal-events"
        }
      }
    },
    {
      "id": "buildup.customer.export",
      "method": "GET",
      "path": "/api/external/customers",
      "provider": "buildup-ev",
      "caller": "EVN-WARP",
      "capability": "customer.export",
      "sources": {
        "EVN-WARP": {
          "file": "lib/buildup-import/client.ts",
          "token": "/api/external/customers${q}"
        },
        "buildup-ev": {
          "file": "backend/src/routes/external.ts",
          "token": "externalRouter.get('/customers'"
        }
      }
    },
    {
      "id": "buildup.customer.link",
      "method": "POST",
      "path": "/api/external/customers/link",
      "provider": "buildup-ev",
      "caller": "EVN-WARP",
      "capability": "customer.link.write",
      "sources": {
        "EVN-WARP": {
          "file": "lib/buildup-import/client.ts",
          "token": "/api/external/customers/link"
        },
        "buildup-ev": {
          "file": "backend/src/routes/external.ts",
          "token": "externalRouter.post('/customers/link'"
        }
      }
    },
    {
      "id": "buildup.quote-document.read",
      "method": "GET",
      "path": "/api/external/quotes/:id/quote-pdf",
      "provider": "buildup-ev",
      "caller": "EVN-WARP",
      "capability": "quote-document.read",
      "sources": {
        "EVN-WARP": {
          "file": "lib/buildup-import/client.ts",
          "token": "/api/external/quotes/${quoteId}/${kind}"
        },
        "buildup-ev": {
          "file": "backend/src/routes/external.ts",
          "token": "externalRouter.get('/quotes/:id/quote-pdf'"
        }
      }
    },
    {
      "id": "buildup.contract-document.read",
      "method": "GET",
      "path": "/api/external/quotes/:id/contract-pdf",
      "provider": "buildup-ev",
      "caller": "EVN-WARP",
      "capability": "contract-document.read",
      "sources": {
        "EVN-WARP": {
          "file": "lib/buildup-import/client.ts",
          "token": "/api/external/quotes/${quoteId}/${kind}"
        },
        "buildup-ev": {
          "file": "backend/src/routes/external.ts",
          "token": "externalRouter.get('/quotes/:id/contract-pdf'"
        }
      }
    },
    {
      "id": "buildup.linked-quotes.list",
      "method": "GET",
      "path": "/api/external/customers/:warpCustomerId/quotes",
      "provider": "buildup-ev",
      "caller": "EVN-WARP",
      "capability": "linked-customer.quote.read",
      "sources": {
        "EVN-WARP": {
          "file": "lib/buildup-import/quotes-client.ts",
          "token": "/api/external/customers/${encodeURIComponent(customerId)}/quotes"
        },
        "buildup-ev": {
          "file": "backend/src/routes/external.ts",
          "token": "/customers/:warpCustomerId/quotes"
        }
      }
    },
    {
      "id": "buildup.linked-quote.snapshot",
      "method": "GET",
      "path": "/api/external/customers/:warpCustomerId/quotes/:quoteId",
      "provider": "buildup-ev",
      "caller": "EVN-WARP",
      "capability": "linked-customer.quote.read",
      "sources": {
        "EVN-WARP": {
          "file": "lib/buildup-import/quotes-client.ts",
          "token": "/api/external/customers/${encodeURIComponent(customerId)}/quotes/${quoteId}"
        },
        "buildup-ev": {
          "file": "backend/src/routes/external.ts",
          "token": "/customers/:warpCustomerId/quotes/:quoteId"
        }
      }
    }
  ],
  "proposed_extension": {
    "status": "user-approved-for-scoped-release",
    "scope": "Exact linked customer quote list and read-only snapshot. WARP applies user-selected values with existing lead revision/audit rules. No automatic stage change or BuildUP customer/quote writes.",
    "issues": {
      "EVN-WARP": "https://github.com/EVNSolution/EVN-WARP/issues/166",
      "buildup-ev": "https://github.com/EVNSolution/buildup-ev/issues/483"
    },
    "pull_requests": {
      "EVN-WARP": "https://github.com/EVNSolution/EVN-WARP/pull/167",
      "buildup-ev": "https://github.com/EVNSolution/buildup-ev/pull/484"
    },
    "authorization": {
      "date": "2026-10-16",
      "source": "explicit user instruction in development task",
      "scope": "Both linked-customer read endpoints, frozen quote facts preservation, WARP quote application and production deployment",
      "executing_github_account": "SUMZ711"
    }
  }
}
