// buildup-ev Prisma schema
// datasource: PostgreSQL (docker-compose 기본값)
// 마이그레이션 방식: prisma db push (ERD 안정 전까지 마이그레이션 파일 없음)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── F: 인증·권한 ──────────────────────────────────────────────────────────

enum OrgType {
  HQ
  DEALER
  MAKER
}

model Org {
  code   String  @id @db.VarChar(30)
  type   OrgType
  name   String  @db.VarChar(60)
  biz_no String? @db.VarChar(20)
  active Boolean @default(true)

  users       User[]
  quote_orgs  Quote[]  @relation("QuoteOrg")
  maker_orders Order[] @relation("OrderMakerOrg")

  @@map("org")
}

enum Role {
  SALES
  ADMIN
  MAKER
}

enum UserStatus {
  active
  invited
  suspended
}

model User {
  email          String     @id @db.VarChar(120)
  org_code       String     @db.VarChar(30)
  /// 주 역할 — 로그인 후 첫 화면·배지의 기준(하나뿐)
  role           Role
  /// 겸직 — 주 역할 외에 더 가진 역할. 권한은 역할들의 합집합으로 본다.
  extra_roles    Role[]
  name           String     @db.VarChar(60)
  phone          String?    @db.VarChar(20)
  status         UserStatus @default(invited)
  must_change_pw Boolean    @default(true)
  invited_by     String?    @db.VarChar(120)
  active         Boolean    @default(true)
  created_at     DateTime   @default(now())
  password_hash  String?    @db.VarChar(80)
  login_attempts Int        @default(0)
  locked_until   DateTime?
  // DEV: master surface switcher — true인 계정만 surface 전환 토글 표시 (테스트용)
  is_master      Boolean    @default(false)

  org              Org        @relation(fields: [org_code], references: [code])
  inviter          User?      @relation("Invites", fields: [invited_by], references: [email])
  invitees         User[]     @relation("Invites")
  customers        Customer[]
  sales_quotes     Quote[]    @relation("QuoteSales")

  @@map("user")
}

enum SubjectType {
  role
  user
}

model FeatureModule {
  code       String  @id @db.VarChar(40)
  name       String  @db.VarChar(60)
  surface    String  @db.VarChar(60)
  sort_order Int     @default(0)
  active     Boolean @default(true)

  access_controls AccessControl[]

  @@map("feature_module")
}

model AccessControl {
  id           BigInt      @id @default(autoincrement())
  subject_type SubjectType
  subject_ref  String      @db.VarChar(120)
  module_code  String      @db.VarChar(40)
  enabled      Boolean     @default(true)
  memo         String?

  module FeatureModule @relation(fields: [module_code], references: [code])

  @@unique([subject_type, subject_ref, module_code])
  @@map("access_control")
}

// ─── A: 제품·옵션 ──────────────────────────────────────────────────────────

model VehicleModel {
  code               String  @id @db.VarChar(30)
  name               String  @db.VarChar(60)
  drive_type         String  @db.VarChar(10)
  seats_default      Int
  length_mm          Int?
  width_mm           Int?
  height_mm          Int?
  wheelbase_mm       Int?
  tread_front_mm     Int?
  tread_rear_mm      Int?
  curb_weight_kg     Int?
  curb_axle_front_kg Int?
  curb_axle_rear_kg  Int?
  gvw_limit_kg       Int?
  max_length_mm      Int?
  max_width_mm       Int?
  max_height_mm      Int?
  default_tire_front String? @db.VarChar(30)
  default_tire_rear  String? @db.VarChar(30)
  active             Boolean @default(true)

  option_group_models OptionGroupModel[]
  option_prices       OptionPrice[]
  door_unit_prices    DoorUnitPrice[]
  subsidies_national  SubsidyNational[]
  quotes              Quote[]

  @@map("vehicle_model")
}

model OptionGroup {
  code        String  @id @db.VarChar(40)
  category    String? @db.VarChar(40)
  name        String  @db.VarChar(60)
  select_type String  @db.VarChar(20)
  required    Boolean @default(false)
  sort_order  Int     @default(0)
  active      Boolean @default(true)

  values OptionValue[]
  models OptionGroupModel[]

  @@map("option_group")
}

model OptionValue {
  code       String  @id @db.VarChar(40)
  group_code String  @db.VarChar(40)
  name       String  @db.VarChar(60)
  vivar_code String? @db.VarChar(40)
  sort_order Int     @default(0)
  active     Boolean @default(true)

  group         OptionGroup   @relation(fields: [group_code], references: [code])
  prices        OptionPrice[]
  order_options OrderOption[]

  @@map("option_value")
}

model OptionGroupModel {
  group_code String @db.VarChar(40)
  model_code String @db.VarChar(30)

  group OptionGroup  @relation(fields: [group_code], references: [code])
  model VehicleModel @relation(fields: [model_code], references: [code])

  @@id([group_code, model_code])
  @@map("option_group_model")
}

// option_rule: 종속제약. target_code는 폴리모픽(group/value 코드) → FK 없음
model OptionRule {
  code        String  @id @db.VarChar(40)
  when_value  String  @db.VarChar(40)
  effect      String  @db.VarChar(20)
  target_type String  @db.VarChar(20)
  target_code String  @db.VarChar(40)
  memo        String?

  @@map("option_rule")
}

// ─── B: 가격·보조금·세율 ──────────────────────────────────────────────────

model OptionPrice {
  model_code   String @db.VarChar(30)
  value_code   String @db.VarChar(40)
  supply_price Int
  memo         String?

  model VehicleModel @relation(fields: [model_code], references: [code])
  value OptionValue  @relation(fields: [value_code], references: [code])

  @@id([model_code, value_code])
  @@map("option_price")
}

model DoorUnitPrice {
  model_code String @db.VarChar(30)
  top        String @db.VarChar(20)
  doortype   String @db.VarChar(20)
  unit_price Int

  model VehicleModel @relation(fields: [model_code], references: [code])

  @@id([model_code, top, doortype])
  @@map("door_unit_price")
}

model Region {
  name    String @id @db.VarChar(60)
  sido    String @db.VarChar(20)
  sigungu String @db.VarChar(30)

  subsidies_local SubsidyLocal[]

  @@map("region")
}

model SubsidyNational {
  model_code  String   @db.VarChar(30)
  year        Int
  amount      Int
  sosang_rate Decimal? @db.Decimal(5, 4)

  model VehicleModel @relation(fields: [model_code], references: [code])

  @@id([model_code, year])
  @@map("subsidy_national")
}

model SubsidyLocal {
  region          String  @db.VarChar(60)
  year            Int
  amount          Int
  extra           Int?
  remaining_quota Int?
  as_of           String? @db.VarChar(20)
  active          Boolean @default(true) // 예산 소진 시 관리자가 off → 견적에 지방보조금 미적용

  region_ref Region @relation(fields: [region], references: [name])

  @@id([region, year])
  @@map("subsidy_local")
}

model TaxConfig {
  param_key String  @id @db.VarChar(40)
  value     Decimal @db.Decimal(12, 4)
  unit      String? @db.VarChar(20)
  memo      String?

  @@map("tax_config")
}

/// 견적 수정 이력 — 한 견적 안에서 무엇이 언제 누구에 의해 바뀌었는지.
///
/// 견적서·계약서가 오간 뒤에 "왜 금액이 다르냐"는 이야기가 나온다. 그때 되짚을 수
/// 있어야 하므로 옵션·고객정보·할부조건 변경을 전부 같은 표에 필드 단위로 남긴다.
/// (기준데이터 변경이력 option_db_change_log 와 같은 구조 — 익숙한 모양을 유지)
model QuoteChangeLog {
  id         Int      @id @default(autoincrement())
  quote_id   Int
  /// options | customer | inputs — 수정 팝업의 탭과 같은 구분
  section    String   @db.VarChar(20)
  field      String   @db.VarChar(60)
  old_value  String?  @db.VarChar(300)
  new_value  String?  @db.VarChar(300)
  changed_by String   @db.VarChar(120)
  changed_at DateTime @default(now())

  quote Quote @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@index([quote_id, changed_at])
  @@map("quote_change_log")
}

/// 견적번호 채번대장 — **한 번 나간 번호는 다시 나오지 않게** 발급 기록을 견적 행과 분리한다.
/// 예전엔 남아 있는 견적의 최대번호 +1 이라, 견적을 지우면 그 번호가 되살아났다.
/// 견적서·계약서는 번호를 달고 고객에게 나가므로 번호 재사용은 되돌릴 수 없는 사고가 된다.
model QuoteNoCounter {
  /// 4자리 연도(2026)
  year       Int      @id
  /// 그 해에 마지막으로 발급한 일련번호
  last_seq   Int
  updated_at DateTime @default(now())

  @@map("quote_no_counter")
}

/// 옵션DB(기준데이터) 변경 이력 — 관리자 수정 시 필드별 이전값→새값·수정자·수정일시 기록.
model OptionDbChangeLog {
  id         Int      @id @default(autoincrement())
  table_name String   @db.VarChar(40) // option_price · tax_config · subsidy_local …
  row_key    String   @db.VarChar(160) // PK 조합 (예: PV5_OPENBED|TOP_REEFER_LOW)
  field      String   @db.VarChar(40)
  old_value  String?  @db.VarChar(200)
  new_value  String?  @db.VarChar(200)
  action     String   @db.VarChar(10) // create | update | delete
  changed_by String   @db.VarChar(120) // 수정자 이메일
  changed_at DateTime @default(now())

  @@index([table_name, row_key])
  @@index([changed_at])
  @@map("option_db_change_log")
}

/// 할부개월수별 연이율 (총견적서 옵션DB AF/AG). months=0 → 일시불(이율 0).
model InstallmentRate {
  months Int     @id // 할부개월수 (0=일시불, 36, 48, 60 …)
  rate   Decimal @db.Decimal(6, 4) // 연이율 (예: 0.0660)
  label  String? @db.VarChar(40) // 표시명(예: 일시불)
  active Boolean @default(true)

  @@map("installment_rate")
}

// 무게계산 상수 (차종기준·항목무게/위치·타이어·탑무게 수식계수). 관리자 CRUD, 숫자만 바꾸면 재계산.
// 단일소스 = shared/bom/weight-constants.ts WEIGHT_CONSTANT_SEED. 계산은 순수함수에 주입(값 없으면 throw).
model WeightConstant {
  key         String  @id @db.VarChar(60)
  category    String  @db.VarChar(20)
  value       Decimal @db.Decimal(14, 6)
  unit        String? @db.VarChar(20)
  description String?
  updated_at  DateTime @default(now()) @updatedAt

  @@map("weight_constant")
}

// ─── D1: 타이어 ───────────────────────────────────────────────────────────

model Tire {
  spec              String @id @db.VarChar(40)
  allowable_load_kg Int

  @@map("tire")
}

// ─── E: 거래 (customer · quote · order · order_option · document) ─────────

/// 고객 마스터. 견적을 반복해서 넣는 고객이 많아 (성명/상호 + 생년월일/사업자번호)로
/// 같은 고객을 알아보고 갱신한다 — 예전엔 견적마다 새 행이 쌓였다.
model Customer {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(60)
  /// 대표이사 — 법인사업자일 때만 채운다. 계약서 매수인 법인 줄에 인쇄된다.
  ceo_name   String?  @db.VarChar(60)
  email      String?  @db.VarChar(120)
  /// 휴대폰
  phone      String?  @db.VarChar(20)
  /// 유선 전화번호(계약서 «전화번호» 칸). 입력했을 때만 저장된다.
  tel        String?  @db.VarChar(20)
  address    String?  @db.VarChar(120)
  /// 동·호수 등 상세주소. 주소 검색으로 채운 도로명주소(address)의 뒷부분.
  address_detail String? @db.VarChar(120)
  /// 생년월일 또는 사업자번호. name 과 함께 고객을 식별하는 키다.
  reg_no     String?  @db.VarChar(20)
  created_by String?  @db.VarChar(120)
  created_at DateTime @default(now())

  creator User?   @relation(fields: [created_by], references: [email])
  quotes  Quote[]

  /// 자동 기입 조회용. ⚠️ UNIQUE 가 아니다 — 이미 같은 (name, reg_no) 중복 행이 쌓여 있어
  /// 유니크 제약을 걸면 마이그레이션이 실패한다. 중복은 코드에서 최신 1건을 쓴다.
  @@index([name, reg_no])
  @@map("customer")
}

/// 견적 진행 단계 6 + 만료.
///   draft      임시저장 — 작성 중
///   confirmed  견적확정 — 견적서 생성
///   contracted 계약완료 — 전자서명 완료(자동)
///   assigned   배정완료 — 관리자가 특장사 배정
///   ordered    주문진행 — 특장사가 수락
///   completed  완료     — 특장사가 모든 공정 완료
enum QuoteStatus {
  draft
  confirmed
  contracted
  assigned
  ordered
  completed
  expired
}

model Quote {
  id            Int         @id @default(autoincrement())
  quote_no      String?     @unique @db.VarChar(10)
  customer_id   Int?
  model_code    String      @db.VarChar(30)
  selections    Json        @default("{}")
  inputs        Json        @default("{}") // 총견적서 입력시트 스냅샷(구분·소상공인·지역·면세·선수금비율·할부개월수·영업용번호판 등)
  supply_price  Int?
  final_price   Int?
  status        QuoteStatus @default(draft)
  sales_user_id String?     @db.VarChar(120)
  org_id        String?     @db.VarChar(30)
  created_at    DateTime    @default(now())

  // 참고용 메일 발송(견적서·계약서 PDF 첨부) 이력 — 전자서명(purchase_contract)과는 별개 채널.
  // 관리자 견적 목록에서 '보냈는지/언제/누구에게' 를 확인하는 용도. 마지막 발송 기준.
  docs_emailed_at DateTime?
  docs_emailed_to String?   @db.VarChar(200)

  // 서류 고정 — 전자서명 '요청 발송' 시점에 견적서·계약서 PDF 를 파일로 굳힌다.
  // 고정 후에는 옵션 단가·세율이 바뀌어도 저장본을 그대로 내려주고, 입력 수정도 막는다.
  // (고객이 서명한 문서와 시스템이 어긋나면 안 되므로 값 재계산이 아니라 바이트 보존)
  docs_frozen_at   DateTime?
  docs_frozen_quote_path    String? @db.VarChar(300)
  docs_frozen_contract_path String? @db.VarChar(300)

  customer   Customer?    @relation(fields: [customer_id], references: [id])
  model      VehicleModel @relation(fields: [model_code], references: [code])
  change_logs QuoteChangeLog[]
  sales_user User?        @relation("QuoteSales", fields: [sales_user_id], references: [email])
  org        Org?         @relation("QuoteOrg", fields: [org_id], references: [code])
  order      Order?
  contracts  PurchaseContract[]

  @@map("quote")
}

// 주문 상태 순서(앱 레벨 강제): 제작착수→구조변경→튜닝신청→안전검사→튜닝승인→인도완료
model Order {
  id           Int       @id @default(autoincrement())
  quote_id     Int       @unique
  status       String    @default("제작착수") @db.VarChar(30)
  maker_org_id String?   @db.VarChar(30)
  assigned_at  DateTime?
  created_at   DateTime  @default(now())
  // 구조변경 서류 바인딩용 차량 정보 (특장사 입력)
  vehicle_info Json?

  quote     Quote        @relation(fields: [quote_id], references: [id])
  maker_org Org?         @relation("OrderMakerOrg", fields: [maker_org_id], references: [code])
  options   OrderOption[]
  documents Document[]
  generated_documents GeneratedDocument[]

  @@map("order")
}

model OrderOption {
  id         Int    @id @default(autoincrement())
  order_id   Int
  group_code String @db.VarChar(40)
  value_code String @db.VarChar(40)

  order Order       @relation(fields: [order_id], references: [id])
  value OptionValue @relation(fields: [value_code], references: [code])

  @@unique([order_id, group_code])
  @@map("order_option")
}

enum DocStatus {
  pending
  done
  na
}

model Document {
  id       Int       @id @default(autoincrement())
  order_id Int
  name     String    @db.VarChar(60)
  status   DocStatus @default(pending)

  order Order @relation(fields: [order_id], references: [id])

  @@map("document")
}

// 자동생성 구조변경 서류(PDF) 이력. 관청 제출물이라 재생성해도 덮어쓰지 않고 버전 누적.
// 같은 (order_id, type) 의 최신 버전 = version 최댓값.
enum GeneratedDocType {
  load_calc
  spec_table
  work_order
  contract // 특장 매매 및 구조변경 계약서
}

model GeneratedDocument {
  id           Int              @id @default(autoincrement())
  order_id     Int
  type         GeneratedDocType
  version      Int
  file_path    String           @db.VarChar(500)
  generated_at DateTime         @default(now())

  order Order @relation(fields: [order_id], references: [id])

  @@unique([order_id, type, version])
  @@map("generated_document")
}

// ─── F: 전자서명(모두싸인) 구매계약 ─────────────────────────────────────────
// 상태: DRAFT→SENT→VIEWED→SIGNING→COMPLETED, 분기 REJECTED/CANCELED.
// 재발송 허용 → order 당 여러 행 누적(최신=현재 계약). 서명본은 DOC_STORAGE_DIR 하위 저장.
enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  SIGNING
  COMPLETED
  REJECTED
  CANCELED
}

model PurchaseContract {
  id                   Int            @id @default(autoincrement())
  quote_id             Int            // 계약은 견적(확정 시점)에 연결. 주문 생성 전에도 발송 가능.
  modusign_document_id String?        @unique @db.VarChar(80)
  signing_method       String         @db.VarChar(10) // EMAIL | KAKAO
  status               ContractStatus @default(DRAFT)
  customer_snapshot    Json           // 발송시점 고객 스냅샷(이름/연락처)
  signed_pdf_path      String?        @db.VarChar(500)
  sent_at              DateTime?
  completed_at         DateTime?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @default(now()) @updatedAt

  quote Quote @relation(fields: [quote_id], references: [id])

  @@index([quote_id])
  @@map("purchase_contract")
}

// webhook 멱등 dedup. (document_id, event_type) 유일 — 같은 이벤트 재수신 무시.
model ModusignWebhookEvent {
  id          Int      @id @default(autoincrement())
  document_id String   @db.VarChar(80)
  event_type  String   @db.VarChar(60)
  received_at DateTime @default(now())

  @@unique([document_id, event_type])
  @@map("modusign_webhook_event")
}

// ─── C, D2 보류 — TODO 2단계 ───────────────────────────────────────────────
// material · part · bom_line · drawing
// ERD 안정 후 추가
