# .env.example — 실제 값은 .env 에 입력 (절대 커밋 금지)

# 서버
PORT=3001
NODE_ENV=development

# 데이터베이스
DATABASE_URL=postgresql://buildup:buildup_dev@localhost:5432/buildup_ev

# 인증/JWT — 강한 랜덤값 필수: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 마스터 관리자 초기 계정 (실제 값은 .env 에만 입력)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PW=

# CORS
CORS_ORIGIN=http://localhost:5173

# 구조변경 서류(PDF) 저장 경로 — 배포 워크트리(/srv/buildup-ev) 밖에 둘 것.
# 그 안에 두면 다음 자동배포(git 워크트리 교체) 때 소실됨.
DOC_STORAGE_DIR=/srv/buildup-ev-data/documents
