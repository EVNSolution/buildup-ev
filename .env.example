# .env.example — 실제 값은 .env 에 입력 (절대 커밋 금지)

# 서버
PORT=3001
NODE_ENV=development

# 데이터베이스
DATABASE_URL=postgresql://buildup:buildup_dev@localhost:5432/buildup_ev

# 인증/JWT — 강한 랜덤값 필수: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 마스터 관리자 초기 계정 (실제 값은 .env 에만 입력)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PW=

# CORS
CORS_ORIGIN=http://localhost:5173

# WARP CRM 연동 (견적 고객정보 자동 기입) — 미설정 시 기능만 조용히 꺼진다(다른 기능 무영향)
# WARP_API_KEY 는 WARP 서버의 WARP_LOOKUP_API_KEY 와 같은 값 (openssl rand -hex 32)
WARP_API_BASE_URL=
WARP_API_KEY=
