# .env.example — 실제 값은 .env 에 입력 (절대 커밋 금지)

# 서버
PORT=3001
NODE_ENV=development

# 데이터베이스
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buildup_ev

# 인증/JWT — 강한 랜덤값 필수: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 마스터 관리자 초기 비밀번호 (설정 시 bootstrap에서 사용, 없으면 무작위 생성)
BOOTSTRAP_ADMIN_PW=

# CORS
CORS_ORIGIN=http://localhost:5173

# 외부 API (미확정)
VIVAR_API_URL=
VIVAR_API_KEY=
