# .env.example — 이름과 용도만 관리한다. 실제 값은 절대 커밋하지 않는다.

# 로컬 실행 전용. 운영 배포에서는 스크립트가 주입하며 SSM에 저장하지 않는다.
PORT=3001
NODE_ENV=development
DOC_STORAGE_DIR=.local-doc-storage

# 운영 필수
DATABASE_URL=postgresql://buildup:buildup_dev@localhost:5432/buildup_ev
JWT_SECRET=
MODUSIGN_DRY_RUN=true

# 메일 알림. USER와 PASS는 함께 설정한다.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM_NAME=EV&Solution
NOTIFY_ADMIN_TO=
PUBLIC_BASE_URL=https://buildup-ev.cleversystem.ai

# 모두싸인. 실제 발송 전까지 MODUSIGN_DRY_RUN=true를 유지한다.
MODUSIGN_BASE_URL=https://api.modusign.co.kr
MODUSIGN_API_KEY=
MODUSIGN_WEBHOOK_SECRET=

# 현재 WARP 연동 설정. 계약 변경은 이 저장소 작업 범위가 아니다.
WARP_API_BASE_URL=
WARP_API_KEY=

# 일회성 로컬 bootstrap에만 사용한다. 운영 SSM 애플리케이션 ENV에는 넣지 않는다.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PW=
